# OpenRouter API Key (Required for live LLM inference)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter Model identifier (Default: openai/gpt-5-mini)
# You can also use other models available on OpenRouter, e.g.:
# openai/gpt-4o-mini, anthropic/claude-3.5-haiku, deepseek/deepseek-chat
OPENROUTER_MODEL=openai/gpt-5-mini

# GitHub Personal Access Token (Optional: increases rate limits for GitHub REST API)
# Get one at: https://github.com/settings/tokens
# If left blank, the agent uses public GitHub endpoints and graceful fallback data.
GITHUB_TOKEN=
